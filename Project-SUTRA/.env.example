# Project SUTRA local settings. Loaded by start-all.ps1 into every service it starts.
# Commit this template; copy it to .env for local settings. The local .env file is git-ignored.
# Leave a value empty to use the built-in default from the service's application.yml.
# Ports and service URLs (AUTH_PORT, RFQ_URL, ...), DB_URL and SUTRA_PUBLIC_RATE_LIMIT are set by start-all.ps1.

# --- Database (PostgreSQL) ---
DB_USERNAME=sutra
DB_PASSWORD=sutra_pass

# --- Auth ---
# Empty: start-all.ps1 creates a random secret once and keeps it as a Windows user setting.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
SUTRA_MAX_FAILED_LOGINS=5
SUTRA_LOCKOUT_MINUTES=15

# Initial admin account, created on a fresh database
SUTRA_ADMIN_USERNAME=admin
SUTRA_ADMIN_EMAIL=admin@sutra.local
SUTRA_ADMIN_PASSWORD=Admin@123

# --- Gateway ---
CORS_ORIGINS=http://localhost:5173

# --- Extraction: Groq (empty key = rule-based reader only) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=16000
GROQ_TIMEOUT=120
SUTRA_ENGINE_ORDER=GROQ,RULES
SUTRA_EXTRACTION_CONCURRENCY=1

# --- Extraction: OCR (Tesseract, for scanned PDFs) ---
SUTRA_OCR_ENABLED=true
# Empty = look for tesseract on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=
TESSERACT_LANGUAGES=eng
SUTRA_OCR_DPI=300
SUTRA_OCR_MAX_PAGES=30
SUTRA_OCR_TIMEOUT=120

# --- Python document reader ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=60

# --- Uploads ---
SUTRA_MAX_FILE_MB=20
SUTRA_MAX_FILE_BYTES=20971520
SUTRA_ORPHAN_AFTER_MINUTES=60

# --- Frontend dev server: where /api is proxied ---
SUTRA_API_URL=http://localhost:8080

